{
  "name": "clrsweb-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check:content": "node scripts/checkContent.mjs",
    "build": "node scripts/buildExperiments.mjs && node scripts/checkContent.mjs --soft && astro build",
    "build:release": "node scripts/buildExperiments.mjs && node scripts/checkContent.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^7.4.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "node": "^22.23.4"
  }
}
