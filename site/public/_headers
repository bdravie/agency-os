# Cloudflare Pages response headers. Keeps the post-purchase page and its files out of search results even if a crawler ignores the page's own noindex tag.
# (Pages Functions handle only "/" and "/e", so these static paths are served as plain files with these headers.)
/thanks-*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/files/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
