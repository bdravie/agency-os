---
// The blog's front page: every published post, newest first. Posts are Markdown files in src/blog/ (see src/blog/_template.md).
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../content/site.json";
import { posts, NICHES, longDate } from "../blog";
const description = "Plain guides for dental practices and aesthetics clinics on missed calls, enquiries and keeping the diary full.";
const jsonLd = { "@context": "https://schema.org", "@type": "Blog", name: `${site.businessName} blog`, url: new URL("/blog", Astro.site).href, description };
---
<Base title={`Blog | ${site.businessName}`} description={description} canonical="/blog" jsonLd={jsonLd}>
  <Header current="blog" />
  <main><section class="hero"><div class="wrap">
    <div class="label" data-reveal>Blog</div>
    <h1 data-reveal>Plain guides for clinic owners</h1>
    <p class="sub" data-reveal>Where calls and enquiries go missing, and what to do about it. Written for dental practices and aesthetics clinics.</p>
    {posts.length === 0
      ? <p class="muted">The first posts are on their way.</p>
      : <div class="posts">
          {posts.map((p) => (
            <a class="card post-card" href={`/blog/${p.slug}`} data-reveal>
              <div class="meta"><span class="tag">{NICHES[p.niche]}</span><span>{longDate(p.date)}</span><span>{p.minutes} min read</span></div>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <span class="more">Read it →</span>
            </a>
          ))}
        </div>}
  </div></section></main>
  <Footer />
</Base>
