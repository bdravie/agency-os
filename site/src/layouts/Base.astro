---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
import "../styles/site.css";
// noindex is for private pages (e.g. the post-purchase page): it asks search engines not to list the page and drops the canonical link to the home page.
const { title, description = "Systems that bring in more work and give you your time back.", noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow, noarchive" />
      : <link rel="canonical" href={new URL("/", Astro.site).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body><slot /></body>
</html>
