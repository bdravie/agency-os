---
// One landing page for clinics (dental practices and aesthetics clinics), filled from a variant file. The same markup serves every
// variant so a split test changes only the words: the headline, the line under it, the three "what changes" items and the closing line.
// The clinic offer handles patients' details, so the page pitches a conversation, says a data processing agreement comes first,
// keeps to booking logistics and states no figures (CLAUDE.md, business rules). The clinic scene is marked as an illustration.
// Layout (redesign, 24 Nov 2026): one plain background, the clinic scene across the full width under the headline, then plain
// sections with the heading on the left and the content on the right. No cards, no bands.
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ClinicScene from "../components/ClinicScene.astro";
import site from "../content/site.json";
import { posts, NICHES, longDate } from "../blog";
const { v } = Astro.props;
const cta = site.calLink;
const calPath = new URL(site.calLink).pathname.replace(/^\//, "");
const latest = posts.slice(0, 2);
const jsonLd = {
  "@context": "https://schema.org", "@type": "ProfessionalService", name: site.businessName, url: Astro.site?.href, email: site.contactEmail,
  areaServed: "GB", description: v.sub,
};
const promises = [
  ["Booking logistics only.", "Times, changes and cancellations. Never clinical questions, treatments or medicines."],
  ["A person for everything else.", "Anything outside booking is handed to your team, with a note of what was asked."],
  ["Data protection before anything else.", "A data processing agreement and impact assessment are signed first, with every supplier listed."],
  ["Your diary, your rules.", "It follows your opening hours and booking rules, and there is an agreed plan for when something stops working."],
];
---
<Base title={`${site.businessName}: ${v.headline}`} description={v.sub} jsonLd={jsonLd}>
  <Header home />
  <main data-variant={v.id}>
    <section class="lead">
      <div class="wrap">
        <p class="who">For dental practices and aesthetics clinics</p>
        <h1>{v.headline}</h1>
        <div class="lead-grid">
          <p class="sub">{v.sub}</p>
          <div>
            <div class="actions">
              <a class="btn" href={cta} data-cta="hero">{v.cta}</a>
              <a class="btn ghost" href="#fit">Not sure? 3 quick questions</a>
            </div>
            <p class="reassure">Free, 30 minutes, no obligation. You talk to me, {site.ownerName}, not a sales team.</p>
          </div>
        </div>
      </div>
      <ClinicScene />
    </section>

    <section class="band fit-band" id="fit"><div class="wrap split fit" data-fit>
      <div class="fit-head">
        <h2>Is it worth a call?</h2>
        <p>Three taps will tell you. Nothing to type, and your answers are not stored.</p>
        <div class="fit-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
      <div>
        <fieldset data-step="kind">
          <legend>What kind of clinic do you run?</legend>
          <div class="choices">
            <button type="button" class="choice" data-a="dental">Dental practice</button>
            <button type="button" class="choice" data-a="aesthetics">Aesthetics clinic</button>
            <button type="button" class="choice" data-a="other">Something else</button>
          </div>
        </fieldset>
        <fieldset data-step="gap" hidden>
          <legend>When the front desk is busy or closed, what happens to calls and enquiries?</legend>
          <div class="choices">
            <button type="button" class="choice" data-a="missed">Some go unanswered</button>
            <button type="button" class="choice" data-a="callback">We call back when we can</button>
            <button type="button" class="choice" data-a="covered">Every one gets answered</button>
          </div>
        </fieldset>
        <fieldset data-step="when" hidden>
          <legend>If that could be fixed, when would you want it in place?</legend>
          <div class="choices">
            <button type="button" class="choice" data-a="now">As soon as possible</button>
            <button type="button" class="choice" data-a="soon">In the next few months</button>
            <button type="button" class="choice" data-a="looking">Just looking for now</button>
          </div>
        </fieldset>
        <div class="fit-result" data-result hidden aria-live="polite">
          <h3></h3>
          <p></p>
          <div class="actions">
            <a class="btn" href={cta} data-cta="fit"><span data-main>Pick a time</span></a>
            <a class="btn ghost" href="/blog" data-blog hidden>Read the blog</a>
          </div>
        </div>
        <div class="fit-foot"><button type="button" data-back hidden>Back</button></div>
      </div>
    </div></section>

    <section class="band"><div class="wrap split">
      <h2>{v.changes.title}</h2>
      <ul class="items">
        {v.changes.cards.map((c: { title: string; text: string }) => <li><h3>{c.title}</h3><p>{c.text}</p></li>)}
      </ul>
    </div></section>

    <section class="band" id="how"><div class="wrap split">
      <h2>Three steps, in plain English</h2>
      <ol class="items steps">
        <li><div><h3>A short call</h3><p>You tell me how calls and enquiries reach you today and who books them. I listen and ask questions.</p></div></li>
        <li><div><h3>A clear plan, paperwork first</h3><p>I show you what I would change, what it is designed to do and what it costs. A data processing agreement is signed before anything is connected.</p></div></li>
        <li><div><h3>Set up around your diary</h3><p>I build it around how you already book, test it on sample bookings with your team, and keep it accurate each month.</p></div></li>
      </ol>
    </div></section>

    <section class="band"><div class="wrap split">
      <div>
        <h2>Bookings only. Care stays with your team.</h2>
        <p>When your team cannot pick up, an automated assistant answers, says what it is, and books, moves or cancels an appointment. That is all it does.</p>
      </div>
      <ul class="items ticks">
        {promises.map(([lead, rest]) => (
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg><div><strong>{lead}</strong> {rest}</div></li>
        ))}
      </ul>
    </div></section>

    {site.demoVideoUrl && (
      <section class="band"><div class="wrap split">
        <h2>A two-minute walk-through</h2>
        <p><a class="btn ghost" href={site.demoVideoUrl} data-cta="demo">Watch the demo</a></p>
      </div></section>
    )}

    <section class="band"><div class="wrap split">
      <h2>Straight answers</h2>
      <div>
        <details><summary>Who answers the calls?</summary><p>When your team cannot pick up, an automated assistant does. It says it is an assistant, sticks to booking, and hands anything else to a person at your clinic.</p></details>
        <details><summary>Will it talk to patients about treatment?</summary><p>No. It handles booking logistics only: times, changes and cancellations. Clinical questions, treatments and medicines always go to your team.</p></details>
        <details><summary>What about patient data?</summary><p>Booking an appointment means handling patients' details, so nothing is connected until a data processing agreement and an impact assessment are signed, with every supplier listed. We cover this on the first call.</p></details>
        <details><summary>Does it work with our diary?</summary><p>That is one of the first things I check on the call. It is set up around how you book today, and tested on sample bookings before it goes near a real one.</p></details>
        <details><summary>What does the call cost?</summary><p>Nothing. It is 30 minutes to see whether I can help, with no obligation. If I cannot, I will say so.</p></details>
      </div>
    </div></section>

    {latest.length > 0 && (
      <section class="band"><div class="wrap split">
        <div>
          <h2>Plain guides for clinic owners</h2>
          <p><a href="/blog">All posts</a></p>
        </div>
        <ul class="items">
          {latest.map((p) => (
            <li><a class="post-card" href={`/blog/${p.slug}`}>
              <div class="meta"><span class="tag">{NICHES[p.niche]}</span><span>{longDate(p.date)}</span></div>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
            </a></li>
          ))}
        </ul>
      </div></section>
    )}

    <section class="band closing" id="book"><div class="wrap">
      <h2>{v.closing}</h2>
      <div class="actions"><a class="btn" href={cta} data-cta="final">{v.cta}</a></div>
      <div id="cal" data-cal-link={calPath}></div>
      <p class="muted" style="margin-top:16px">Booking opens a calendar from Cal.com. <a href="/privacy">What is counted</a>.</p>
    </div></section>
  </main>
  <Footer />
  <script is:inline src="/t.js" defer></script>
</Base>
