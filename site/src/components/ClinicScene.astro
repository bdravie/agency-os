---
// The clinic front desk, drawn across the full width of the landing page. Left to right: the diary screen and the phone on the
// reception desk, a clock over the waiting bench, and three treatment room doors, closed, each with a red light on.
// As written here it is the finished daytime picture (call answered, slot booked), which is what a visitor sees without the script
// or with "reduce motion". scripts/clinic.ts plays the story as a loop: the phone rings out, the next call is answered by the
// assistant and booked into the diary, the doors stay shut, then the same after closing with the lights off.
// Clinic rule (CLAUDE.md): it is labelled an illustration, the assistant says it is automated, it only books, and it shows no figures.
// Sizes are in drawing units (1600 by 580); colours come from the .clinic tokens in styles/site.css.
const rows = [
  { y: 168, time: "09:00", slot: "" },
  { y: 212, time: "11:30", slot: "" },
  { y: 256, time: "14:00", slot: "s1" },
  { y: 300, time: "16:45", slot: "s2" },
];
const doors = [990, 1190, 1390];
const tick = "M0 7 l6 6 l11 -13";
---
<div class="clinic" data-clinic aria-hidden="true">
  <svg viewBox="0 0 1600 580" focusable="false">
    <!-- Floor (the stylesheet carries the same line on to the edges of a wide screen) -->
    <path class="k" d="M0 540 H1600" />

    <!-- Reception desk -->
    <rect class="f" x="40" y="384" width="680" height="156" />
    <path class="k" d="M270 400 V524 M500 400 V524" />
    <rect class="ink" x="26" y="366" width="708" height="20" rx="4" />
    <text x="385" y="472" font-size="24" text-anchor="middle" letter-spacing="1">Reception</text>

    <!-- Open or closed sign on the counter -->
    <rect class="f" x="626" y="322" width="92" height="44" rx="4" />
    <text data-open x="672" y="351" font-size="18" text-anchor="middle">Open</text>
    <text data-closed x="672" y="351" font-size="18" text-anchor="middle" opacity="0">Closed</text>

    <!-- Diary screen -->
    <rect class="ink" x="198" y="348" width="24" height="20" />
    <rect class="ink" x="150" y="360" width="120" height="8" rx="4" />
    <rect class="lit" x="60" y="110" width="300" height="240" rx="12" />
    <text class="lt" x="78" y="146" font-size="19">Diary</text>
    {rows.map((r) => r.slot ? (
      <g>
        <g data-free={r.slot} opacity={r.slot === "s1" ? 0 : 1}>
          <rect class="row free" x="74" y={r.y} width="272" height="38" rx="6" />
          <text class="lt" x="88" y={r.y + 25} font-size="17">{r.time}</text>
          <text class="lt soft" x="156" y={r.y + 25} font-size="17">Free</text>
        </g>
        <g data-new={r.slot} opacity={r.slot === "s1" ? 1 : 0}>
          <rect class="row new" x="74" y={r.y} width="272" height="38" rx="6" />
          <text class="lt" x="88" y={r.y + 25} font-size="17">{r.time}</text>
          <text class="lt ok" x="156" y={r.y + 25} font-size="17">New booking</text>
          <path class="tick" d={tick} transform={`translate(312 ${r.y + 14})`} />
        </g>
      </g>
    ) : (
      <g>
        <rect class="row" x="74" y={r.y} width="272" height="38" rx="6" />
        <text class="lt" x="88" y={r.y + 25} font-size="17">{r.time}</text>
        <text class="lt soft" x="156" y={r.y + 25} font-size="17">Booked</text>
      </g>
    ))}

    <!-- Desk phone -->
    <g data-phone>
      <path class="f" d="M452 366 L466 318 H586 L600 366 Z" />
      {[540, 556, 572].map((x) => [332, 344, 356].map((y) => <circle class="ink" cx={x} cy={y} r="3.2" />))}
      <circle class="t" cx="496" cy="344" r="8" />
      <circle data-light="ring" cx="496" cy="344" r="8" fill="var(--accent)" opacity="0" />
      <circle data-light="on" class="good" cx="496" cy="344" r="8" />
      <rect data-handset class="ink" x="446" y="294" width="122" height="26" rx="13" />
    </g>
    <g data-marks opacity="0">
      <path class="mark" d="M468 280 l-10 -18" />
      <path class="mark" d="M507 274 v-20" />
      <path class="mark" d="M546 280 l10 -18" />
    </g>

    <!-- Missed call -->
    <g data-missed opacity="0">
      <rect class="chip" x="420" y="196" width="174" height="44" rx="22" />
      <text class="chip-t" x="507" y="225" font-size="19" text-anchor="middle">Missed call</text>
    </g>

    <!-- What the assistant says -->
    <g data-bubble>
      <rect class="lit" x="380" y="52" width="300" height="184" rx="14" />
      <path class="lit" d="M484 235 L507 268 L530 235" />
      <path d="M487 235 H527" stroke="var(--lit)" stroke-width="5" fill="none" />
      <circle class="good" cx="406" cy="82" r="6" />
      <text class="lt ok" x="420" y="88" font-size="16">Automated assistant</text>
      <g data-wave>{[628, 637, 646, 655].map((x, i) => <rect class="good" x={x} y={[76, 71, 74, 78][i]} width="4" height={[12, 22, 16, 8][i]} rx="2" />)}</g>
      <g data-say="a1">
        <text class="say" x="402" y="126">Hello, you've reached the</text>
        <text class="say" x="402" y="152">clinic. I'm an automated</text>
        <text class="say" x="402" y="178">assistant. Shall I find</text>
        <text class="say" x="402" y="204">you a time?</text>
      </g>
      <g data-say="a2" opacity="0">
        <text class="say" x="402" y="126">14:00 is free.</text>
        <text class="say" x="402" y="152">You're booked in.</text>
      </g>
      <g data-say="a3" opacity="0">
        <text class="say" x="402" y="126">The clinic is closed just</text>
        <text class="say" x="402" y="152">now. I'm an automated</text>
        <text class="say" x="402" y="178">assistant and I can</text>
        <text class="say" x="402" y="204">book you in.</text>
      </g>
      <g data-say="a4" opacity="0">
        <text class="say" x="402" y="126">16:45 is free.</text>
        <text class="say" x="402" y="152">You're booked in.</text>
      </g>
    </g>

    <!-- A booking on its way from the phone to the diary -->
    {["14:00", "16:45"].map((t, i) => (
      <g data-pass={i + 1} opacity="0">
        <rect class="pass" x="-62" y="-19" width="124" height="38" rx="19" />
        <text class="pass-t" x="-40" y="6" font-size="18">{t}</text>
        <path class="pass-k" d={tick} transform="translate(22 -6)" />
      </g>
    ))}

    <!-- Clock and waiting bench -->
    <circle class="f" cx="860" cy="150" r="48" />
    <path class="k" d="M860 108 v8 M860 184 v8 M818 150 h8 M894 150 h8" />
    <path data-hour class="k" d="M860 150 V124" stroke-width="5" transform="rotate(310 860 150)" />
    <path data-minute class="k" d="M860 150 V112" transform="rotate(120 860 150)" />
    <circle class="ink" cx="860" cy="150" r="4.5" />
    <text data-day x="860" y="232" font-size="20" text-anchor="middle">10:20</text>
    <text data-evening x="860" y="232" font-size="20" text-anchor="middle" opacity="0">18:40</text>
    <path class="k" d="M800 482 V540 M920 482 V540 M806 452 V468 M914 452 V468" />
    <rect class="f" x="780" y="412" width="160" height="40" rx="6" />
    <rect class="f" x="772" y="468" width="176" height="14" rx="5" />

    <!-- Treatment rooms: doors closed, light on -->
    {doors.map((x, i) => (
      <g>
        <circle data-glow class="glow" cx={x + 75} cy="172" r="46" />
        <rect class="t" x={x - 9} y="191" width="168" height="349" />
        <rect class="f" x={x} y="200" width="150" height="340" />
        <rect class="t" x={x + 22} y="232" width="24" height="124" rx="4" />
        <text x={x + 98} y="254" font-size="17" text-anchor="middle">Room {i + 1}</text>
        <rect class="ink" x={x + 122} y="368" width="7" height="30" rx="3.5" />
        <rect class="ink" x={x + 51} y="183" width="48" height="8" rx="3" />
        <path class="t" d={`M${x + 57} 183 a18 18 0 0 1 36 0 Z`} />
        <path data-lamp class="on" d={`M${x + 57} 183 a18 18 0 0 1 36 0 Z`} />
      </g>
    ))}
  </svg>
</div>
<div class="wrap clinic-foot">
  <p class="cap" data-clinic-cap>Every room is in use, and the call is still answered and booked in.</p>
  <p class="note">An illustration, not a real clinic or diary</p>
</div>

<script>
  import "../scripts/clinic.ts";
</script>
