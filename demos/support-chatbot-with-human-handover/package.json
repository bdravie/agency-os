{
  "name": "support-chatbot-with-human-handover",
  "private": true,
  "version": "0.1.0",
  "description": "Demo: a support chat that answers from a shop's own help articles, walks through common fixes and hands anything else to a person with the chat attached.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3100 -H 127.0.0.1",
    "eval": "tsx scripts/eval.ts",
    "reset": "tsx scripts/reset.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
