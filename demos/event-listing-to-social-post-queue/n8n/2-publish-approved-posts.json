        "jsonBody": "={{ JSON.stringify({ event_id: String($('Skip anything already posted').item.json.post_id ?? $('Skip anything already posted').item.json.event_id ?? \"\"), event: $('Skip anything already posted').item.json.post_title ?? $('Skip anything already posted').item.json.title ?? \"\", step: \"Publish to Facebook Page\", error: ($json.error?.message ?? $json.error ?? \"Unknown error\").toString(), workflow: $workflow.name }) }}"
      },
      "id": "1718a131-9ae6-536a-a45d-7e79a5209e18",
