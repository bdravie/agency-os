        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.image_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.facebook_post }}"
            },
            {
              "name": "access_token",
              "value": "={{ $('Settings').first().json.page_access_token }}"
            }
          ]
        }
      },
      "id": "577b8df1-fcec-5924-a281-7f69d696d860",
      "name": "Publish photo post to Facebook Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.sheet_url }}/posted",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_id: $('Skip anything already posted').item.json.event_id, title: $('Skip anything already posted').item.json.title, facebook_post_id: $json.post_id, instagram_prepared: JSON.stringify({ step_1: 'POST /' + $('Settings').first().json.ig_user_id + '/media', image_url: $('Skip anything already posted').item.json.image_url, caption: $('Skip anything already posted').item.json.instagram_caption, step_2: 'POST /' + $('Settings').first().json.ig_user_id + '/media_publish with creation_id' }) }) }}"
      },
      "id": "1caaebe8-99ee-512b-84d2-4592287ef7f1",
      "name": "Write event ID to Posted log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        100
      ]
    },
    {
      "parameters": {
