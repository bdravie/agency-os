        "url": "={{ $('Settings').first().json.sheet_url }}/queue/{{ $json.event_id }}/status",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: \"Published\", facebook_post_id: $json.facebook_post_id }) }}"
      },
      "id": "893115f6-cc93-5d94-ae80-972ac0948880",
      "name": "Mark row Published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
