# Copy this file to .env and fill in your own values. Never commit .env.

# GitHub push (fine-grained token: repo bdravie/agency-os, Contents read & write)
GITHUB_TOKEN=

# Database: hosted Postgres on Neon (free tier, region AWS Europe West 2 / London).
# Neon dashboard -> your project -> Connect -> copy the connection string.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Only used if you later run Postgres locally with docker compose:
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# CRM app
APP_PASSWORD=
SESSION_SECRET=
DEMO_MODE=true

# AI
ANTHROPIC_API_KEY=

# Model for AI audit reports: an alias (sonnet, opus, haiku) or a full model id. Blank = sonnet.
# Reports are only drafted when you click the button, and stop at AUDIT_DAILY_CAP a day.
AUDIT_MODEL=
AUDIT_DAILY_CAP=10

# Model for analysing call transcripts (alias or full model id; blank = sonnet). Only runs when you click Analyse.
CALLS_MODEL=
CALLS_DAILY_CAP=20

# Selling
SENDER_NAME=
BUSINESS_NAME=
BOOKING_LINK=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CAL_WEBHOOK_SECRET=

# Webhooks from the internet (milestone 6)
CLOUDFLARE_TUNNEL_TOKEN=

# Lead Engine
COMPANIES_HOUSE_API_KEY=
GOOGLE_PLACES_API_KEY=
# Hard daily cap on website lookups made by the CRM (free-allowance guard)
PLACES_DAILY_CAP=30

# Optional web search for social pages (Brave Search API). Leave blank to keep it switched off.
# Uses search credits, so it only ever runs when you click, and stops at the daily cap.
SEARCH_API_KEY=
SEARCH_DAILY_CAP=15
APIFY_TOKEN=
# Apify free plan: $5 of credits a month (about $0.16 a day). These keep every search inside it.
APIFY_DAILY_BUDGET_USD=0.15
APIFY_MONTHLY_BUDGET_USD=4
# Apify will not start a run with a spend cap under this ($0.50 at the time of writing). It is a safety cap, not the expected spend.
APIFY_MIN_RUN_CAP_USD=0.5
# Planning estimates only (Apify's own spend cap is what protects you): check the current price in the Apify console.
APIFY_PRICE_PER_PLACE_USD=0.004
APIFY_PRICE_CONTACTS_PER_PLACE_USD=0.002

# Social Engine
UPLOAD_POST_API_KEY=

# Backups (a folder synced to Google Drive / iCloud / OneDrive)
BACKUP_DIR=
# Encrypts backups. Create with: uv run python -m agency.backup --new-key  Keep a copy in your password manager: without it backups can't be restored.
BACKUP_ENCRYPTION_KEY=
# A second, empty database used only to test restores (see docs/backup.md). Must NOT be the live database.
SCRATCH_DATABASE_URL=

# Outcomes: monthly client reports, case studies and testimonial requests (Claude, only when you click)
OUTCOMES_MODEL=
OUTCOMES_DAILY_CAP=20

# Offer suggestions on the company page (Claude, only when you click)
SUGGEST_MODEL=
SUGGEST_DAILY_CAP=15
DM_MODEL=
DM_DAILY_CAP=30

# Apollo: find decision-makers on a company page. The search is free; revealing a work email uses 1 credit per person.
# Create the key in Apollo (Settings > Integrations > API Keys) WITHOUT master-key access, with People API Search, People Enrichment (and Bulk) switched on.
APOLLO_API_KEY=
APOLLO_DAILY_CREDITS=10
APOLLO_MAX_PEOPLE_PER_CLICK=3
# Model for Upwork pitch packs (alias or full id). Defaults to Sonnet.
UPWORK_MODEL=
# Model for the "Explain this week" read-out on Content > What's working (alias or full id). Defaults to Haiku.
CONTENT_MODEL=
# Creator research (Content > Creators) has its own Apify budget, apart from lead search. Real spend is recorded and checked before every run.
# Model for "Break down" on a creator's outlier (alias or full id; defaults to Sonnet) and how many breakdowns can run per day.
BREAKDOWN_MODEL=
BREAKDOWN_DAILY_CAP=20
# Model for the weekly content brief (alias or full id; defaults to Sonnet).
BRIEF_MODEL=
CONTENT_APIFY_DAILY_BUDGET_USD=0.30
CONTENT_APIFY_MONTHLY_BUDGET_USD=2
# Rapport research on a saved decision-maker (click-only). Model alias or id, and a cap on how many people can be researched per day.
RAPPORT_MODEL=
RAPPORT_DAILY_CAP=10
# Model for writing niche outreach copy with AI (click-only). Alias or full id. Defaults to Sonnet.
OUTREACH_MODEL=

# Click-to-send email and the reply Inbox (Mailboxes page). Create these in Google Cloud: see docs/SETUP.md section 2b.
# The redirect URI only needs setting if it is not http://127.0.0.1:3000/api/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Calendar: the same Google sign-in app as the mailboxes (GOOGLE_CLIENT_ID and SECRET above) also connects the calendar from the Calendar page.
# Most meetings the CRM will book in one day (it also needs SENDER_NAME and BUSINESS_NAME, which go in every invitation).
CALENDAR_DAILY_CAP=10

# Public site split tests (docs/site-tests.md). SITE_URL is where the public site lives; SITE_STATS_TOKEN is 32+ random characters and must match the secret set on Cloudflare Pages.
SITE_URL=https://clrsweb.uk
SITE_STATS_TOKEN=
