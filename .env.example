# Copy this file to .env and fill in your own values. Never commit .env.

# GitHub push (fine-grained token: repo bdravie/agency-os, Contents read & write)
GITHUB_TOKEN=

# Database (local Postgres in Docker)
POSTGRES_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgres://agency:change-me-to-a-long-random-string@127.0.0.1:5432/agency?sslmode=disable

# CRM app
APP_PASSWORD=
SESSION_SECRET=
DEMO_MODE=true

# AI
ANTHROPIC_API_KEY=

# Selling
SENDER_NAME=
BUSINESS_NAME=
BOOKING_LINK=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CAL_WEBHOOK_SECRET=

# Webhooks from the internet (milestone 6)
CLOUDFLARE_TUNNEL_TOKEN=

# Lead Engine
COMPANIES_HOUSE_API_KEY=
GOOGLE_PLACES_API_KEY=
APIFY_TOKEN=

# Social Engine
UPLOAD_POST_API_KEY=

# Backups (a folder synced to Google Drive / iCloud / OneDrive)
BACKUP_DIR=
